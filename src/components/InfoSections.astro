---
import type { Product } from '../lib/products';
import { isCold } from '../lib/products';
import HowToHeat from './HowToHeat.astro';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const cold = isCold(p);

// Card text keeps allergens in capitals; we only make them bold.
const ingredientParts = (p.ingredients ?? '').split(/(\b[A-Z]{3,}\b)/g);

const NUTRITION_LABELS: Record<string, string> = {
  kJ: 'Energy (kJ)',
  kcal: 'Energy (kcal)',
  Fat: 'Fat',
  'of which saturates': 'of which saturates',
  Carbohydrate: 'Carbohydrate',
  'of which sugars': 'of which sugars',
  Fibre: 'Fibre',
  Protein: 'Protein',
  Salt: 'Salt',
};
const nutritionRows = Object.entries(p.nutrition as Record<string, string[]>);
const cols = p.nutrition_columns;
const basis = cols.join(' ').match(/As (Microwaved|Consumed)/i)?.[0];
const colLabel = (c: string) => c.replace(/^\(As (Microwaved|Consumed)\):?\s*/i, '');
---

<div class="info">
  {
    cold ? (
      <details class="info-item" id="how-to-enjoy">
        <summary>How to enjoy</summary>
        <div class="info-body">
          <p class="heat-main">No heating needed. {p.storage_type === 'Frozen' ? 'Keep it frozen until you serve it.' : 'Keep it in the fridge.'}</p>
          <p class="note">The product card has no other serving instructions. Check the pack.</p>
        </div>
      </details>
    ) : (
      <details class="info-item" id="how-to-heat">
        <summary>How to heat</summary>
        <div class="info-body">
          <HowToHeat product={p} />
        </div>
      </details>
    )
  }

  <details class="info-item">
    <summary>Ingredients and allergens</summary>
    <div class="info-body">
      <p class="allergen-line"><strong>Contains:</strong> {p.allergens.contains.length ? p.allergens.contains.join(', ') : 'none listed'}</p>
      {p.allergens.may_contain.length > 0 && <p class="allergen-line"><strong>May contain:</strong> {p.allergens.may_contain.join(', ')}</p>}
      <p class="note">Allergens as listed on the SuperValu product page. Always check the pack before eating.</p>
      <h3 class="info-h">Ingredients</h3>
      {p.ingredients ? <p class="ingredients">{ingredientParts.map((part, i) => (i % 2 === 1 ? <strong>{part}</strong> : part))}</p> : <p class="note">Ingredients aren't listed on the product card.</p>}
    </div>
  </details>

  <details class="info-item">
    <summary>Nutrition</summary>
    <div class="info-body">
      <table class="nutrition">
        <caption>{basis ? `${basis}. ` : ''}Values as printed on the product card. Pack size: {p.size}.</caption>
        <thead>
          <tr><th scope="col">Typical values</th>{cols.map((c) => <th scope="col">{colLabel(c)}</th>)}</tr>
        </thead>
        <tbody>
          {nutritionRows.map(([key, v]) => (
            <tr class={key.startsWith('of which') ? 'sub' : undefined}>
              <th scope="row">{NUTRITION_LABELS[key] ?? key}</th>
              {v.map((x) => <td>{x}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>

  <details class="info-item">
    <summary>Storage</summary>
    <div class="info-body">
      {p.storage ? <p>{p.storage}</p> : <p class="note">Storage advice isn't listed on the product card.</p>}
    </div>
  </details>

  <details class="info-item">
    <summary>Where it's from</summary>
    <div class="info-body">
      {p.origin_statements.length > 0 ? <p>The ingredients list says: {p.origin_statements.join(', ')}.</p> : <p>The ingredients list doesn't say where the ingredients come from.</p>}
    </div>
  </details>

  <details class="info-item" id="where-to-buy">
    <summary>Where to buy</summary>
    <div class="info-body">
      <p>Clean Cut products at SuperValu and Centra. Not every store stocks every product.</p>
      <p>
        Order to your door: SuperValu opens this product on its online shop. Uber Eats opens Centra Shandon Street, Cork; look
        for the product there. Just Eat is a demo for now. Availability, delivery areas and prices depend on your location and
        the store.
      </p>
    </div>
  </details>
</div>

<style>
  .info {
    border-top: 1px solid var(--rule);
  }
  .info-item {
    border-bottom: 1px solid var(--rule);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: var(--s2) var(--gutter);
    font-weight: 600;
    font-size: var(--fs-body);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    margin-left: var(--s3);
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    transform: rotate(45deg) translateY(-3px);
    transition: transform 160ms ease;
  }
  details[open] > summary::after {
    transform: rotate(-135deg) translate(-2px, -1px);
  }
  .info-body {
    padding: 0 var(--gutter) var(--s4);
    max-width: var(--measure);
  }
  .info-body p {
    margin: 0 0 var(--s3);
  }
  .info-h {
    margin: var(--s4) 0 var(--s2);
    font-size: var(--fs-body);
  }
  .info-item {
    scroll-margin-top: var(--s3);
  }
  .allergen-line {
    font-size: var(--fs-h3);
    line-height: 1.3;
  }
  .ingredients {
    font-size: var(--fs-small);
    line-height: 1.55;
  }
  .note {
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .nutrition {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--s3);
  }
  .nutrition caption {
    text-align: left;
    padding-bottom: var(--s2);
    color: var(--ink-soft);
  }
  .nutrition th,
  .nutrition td {
    padding: var(--s2) var(--s1);
    border-bottom: 1px solid var(--rule);
    text-align: right;
  }
  .nutrition th[scope='row'],
  .nutrition thead th:first-child {
    text-align: left;
    font-weight: 600;
  }
  .nutrition thead th {
    font-weight: 600;
    vertical-align: bottom;
  }
  .nutrition tr.sub th {
    font-weight: 400;
    padding-left: var(--s3);
  }
</style>
