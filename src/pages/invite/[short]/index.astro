---
// Invitation link: the recipient chooses a meal and answers "This one for me". Static route so the
// preview title "Take a look & choose your favourite" is in the HTML.
import MealPage from '../../../components/MealPage.astro';
import { pageProducts, shortSlug, invitePath, type Product } from '../../../lib/products';

export function getStaticPaths() {
  return pageProducts.map((p) => ({ params: { short: shortSlug(p) }, props: { product: p } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<MealPage product={product} path={invitePath(product)} mode="invite" />
