---
import Base from '../layouts/Base.astro';
import DishStrip from './DishStrip.astro';
import PackStepper from './PackStepper.astro';
import PicksBar from './PicksBar.astro';
import { products, CATEGORIES, shortName, mealPath, invitePath, withBase, band, type Product } from '../lib/products';

// Catalogue of all Clean Cut products captured from SuperValu, filtered by category with radio buttons
// (CSS only, works without JavaScript). From a product page it lists the others; in invite mode every link
// stays in invite mode so the recipient can answer with the product they pick. In picks mode every product gets
// Add / − n packs + and a summary bar links to the review page (a wish list, not a shop basket).
interface Props {
  product?: Product;
  mode?: 'standard' | 'invite' | 'picks';
}
const { product: p, mode = 'standard' } = Astro.props;
const list = p ? products.filter((o) => o.slug !== p.slug) : products;
const backHref = p ? (mode === 'invite' ? invitePath(p) : mealPath(p)) : null;
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.id, list.filter((o) => o.category === c.id).length]));
const picks = mode === 'picks';
const title = mode === 'invite' ? 'What would you fancy?' : picks ? 'Choose a few things' : p ? 'Choose another' : 'Clean Cut range';
const ownTitle = mode === 'standard' ? `${title} — Clean Cut Meals (student concept)` : `${title} — Clean Cut Meals`;
---

<Base title={ownTitle} description="Clean Cut products listed on SuperValu Online.">
  <div class:list={['choose', { 'choose--picks': picks }]}>
    <div class="wrap">
      {backHref && <a class="back" href={backHref}>Back to {shortName(p!)}</a>}
      {picks && <a class="back" href={withBase('/')} data-back-invite hidden>Back</a>}
      <h1 class="title">{title}</h1>
      {
        picks ? (
          <p class="lede">Add what you’d like and how many packs of each. Not every store stocks every product.</p>
        ) : (
          <p class="lede">Clean Cut products on SuperValu Online, {list.length} {p ? 'more ' : ''}to browse. Not every store stocks every product.</p>
        )
      }

      <fieldset class="filters">
        <legend class="visually-hidden">Show</legend>
        <input type="radio" name="cat" id="cat-all" value="all" checked />
        <label for="cat-all">All</label>
        {CATEGORIES.map((c) => (
          <>
            <input type="radio" name="cat" id={`cat-${c.id}`} value={c.id} />
            <label for={`cat-${c.id}`}>{c.label} <span class="n">{counts[c.id]}</span></label>
          </>
        ))}
      </fieldset>
    </div>

    <ul class="list">
      {list.map((o) => (
        <li class={`item item--${o.category}`} style={`--band: ${band(o)}`}>
          <DishStrip product={o} href={mode === 'invite' ? invitePath(o) : picks ? `${mealPath(o)}?from=picks` : mealPath(o)} />
          {picks && (
            <div class="pick-ctl">
              <PackStepper id={o.id} name={shortName(o)} />
            </div>
          )}
        </li>
      ))}
    </ul>
    {
      picks && (
        <>
          <PicksBar />
          <noscript><p class="wrap">Choosing a few things needs JavaScript in your browser.</p></noscript>
        </>
      )
    }
    {!p && <p class="wrap foot"><a href={withBase('/about/')}>About this prototype and its sources</a></p>}
  </div>
</Base>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .back::before {
    content: '';
    width: 8px;
    height: 8px;
    margin-right: var(--s2);
    border-left: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
  }
  .title {
    margin: var(--s2) 0 var(--s2);
    font-size: var(--fs-h2);
    line-height: 1.1;
  }
  .lede {
    margin: 0 0 var(--s3);
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  /* Category chips wrap onto two lines on narrow phones instead of scrolling sideways. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: 0 0 var(--s3);
    padding: 0;
    border: 0;
  }
  .filters input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .filters label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-size: var(--fs-small);
    font-weight: 600;
    cursor: pointer;
  }
  .filters .n {
    font-weight: 400;
    color: var(--ink-soft);
  }
  .filters input:checked + label {
    background: var(--ink);
    color: var(--paper);
  }
  .filters input:checked + label .n {
    color: var(--accent);
  }
  .filters input:focus-visible + label {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .choose:has(#cat-meals:checked) .item:not(.item--meals),
  .choose:has(#cat-fakeaway:checked) .item:not(.item--fakeaway),
  .choose:has(#cat-protein-pots:checked) .item:not(.item--protein-pots),
  .choose:has(#cat-breakfast:checked) .item:not(.item--breakfast),
  .choose:has(#cat-ice-cream:checked) .item:not(.item--ice-cream) {
    display: none;
  }
  /* Picks mode: the stepper sits under each product, inside the same colour band. */
  .choose--picks .item :global(.strip) {
    border-bottom: 0;
    padding-bottom: var(--s2);
  }
  .pick-ctl {
    padding: 0 var(--gutter) var(--s3) calc(var(--gutter) - 2px);
    border-left: 10px solid var(--band);
    border-bottom: 1px solid var(--rule);
  }
  .pick-ctl > :global(*) {
    max-width: 18rem;
  }
  .foot {
    margin-top: var(--s4);
    font-size: var(--fs-small);
  }
</style>

