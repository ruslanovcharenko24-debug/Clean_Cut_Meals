---
import MealPage from '../../../components/MealPage.astro';
import { pageProducts, mealPath, type Product } from '../../../lib/products';

export function getStaticPaths() {
  return pageProducts.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<MealPage product={product} path={mealPath(product)} />
