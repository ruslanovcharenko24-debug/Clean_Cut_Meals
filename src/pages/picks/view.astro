---
// A list someone sent back: /picks/view/?c=<compact code> or the older ?p=<id>-<packs>.… (formats in src/lib/picks.ts). The page only reads the
// link: it never changes the viewer's own draft. Products, names, sizes and photos come from the catalogue.
// The preview is the same for every list (a static page cannot tailor it); the message text carries the list.
import Base from '../../layouts/Base.astro';
import PickRow from '../../components/PickRow.astro';
import PicksData from '../../components/PicksData.astro';
import { products, withBase } from '../../lib/products';
---

<Base
  title="These would be lovely. — Clean Cut Meals"
  description="Open to see the products and quantities."
  preview={{
    title: 'These would be lovely.',
    description: 'Open to see the products and quantities.',
    url: withBase('/picks/view/'),
  }}
>
  <div class="view">
    <div class="wrap">
      <h1 class="title" id="view-title">These would be lovely.</h1>
      <p class="note" data-skipped hidden>Part of this link couldn’t be read, so some items may be missing.</p>
      <p class="note warn" role="alert" data-damaged hidden>
        This link looks cut short or changed, so this list may be incomplete. Ask for the link again to see everything.
      </p>
    </div>

    <ul class="list" aria-labelledby="view-title" data-list>
      {products.map((p) => <PickRow product={p} mode="view" />)}
    </ul>

    <p class="wrap thanks" data-thanks hidden>Thank you ❤️</p>

    <div class="wrap empty" data-empty hidden>
      <p>This list link is incomplete, so there is nothing to show. Ask for the link again.</p>
      <a class="btn" href={withBase('/')}>See Clean Cut products</a>
    </div>
    <noscript><p class="wrap">This list needs JavaScript in your browser.</p></noscript>
  </div>
  <PicksData />
</Base>

<script>
  import { decodeLink, decodePicks, readPicksData, unitLabel, type Pick } from '../../lib/picks';

  // Read-only: no draft is loaded or saved here. New links (?c=) carry a check; old links (?p=) are still read.
  const data = readPicksData();
  const params = new URLSearchParams(location.search);
  const compact = params.get('c');
  let picks: Pick[];
  let skipped = 0;
  let damaged = false;
  if (compact !== null) ({ picks, damaged } = decodeLink(compact.trim().toLowerCase(), data.byCode));
  else ({ picks, skipped } = decodePicks(params.get('p'), data.known));
  const list = document.querySelector<HTMLElement>('[data-list]')!;
  const rows = new Map([...list.querySelectorAll<HTMLElement>('[data-pick]')].map((el) => [el.dataset.pick!, el]));
  for (const p of picks) {
    const el = rows.get(p.id)!;
    el.querySelector<HTMLElement>('[data-packs]')!.textContent = unitLabel(p.packs, data.byId.get(p.id)!.unit);
    el.hidden = false;
    list.append(el);
  }
  // Each product shows its own number; no overall total for the person receiving the list.
  document.querySelector<HTMLElement>('[data-thanks]')!.hidden = picks.length === 0;
  document.querySelector<HTMLElement>('[data-skipped]')!.hidden = skipped === 0 || picks.length === 0;
  document.querySelector<HTMLElement>('[data-damaged]')!.hidden = !damaged || picks.length === 0;
  document.querySelector<HTMLElement>('[data-empty]')!.hidden = picks.length > 0;
</script>

<style>
  .title {
    margin: var(--s2) 0 var(--s3);
    font-size: var(--fs-h2);
    line-height: 1.1;
  }
  .thanks {
    margin: var(--s4) 0 0;
    font-size: var(--fs-h3);
    font-weight: 700;
  }
  .thanks[hidden] {
    display: none;
  }
  .note {
    margin: 0 0 var(--s3);
    font-size: var(--fs-small);
  }
  .warn {
    padding: var(--s2) var(--s3);
    border-left: 4px solid var(--ink);
    font-weight: 600;
  }
  .note[hidden],
  .empty[hidden] {
    display: none;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .empty {
    padding-top: var(--s3);
  }
  .empty p {
    margin: 0 0 var(--s3);
  }
</style>
