---
import { Picture, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import ActionBar from '../../../components/ActionBar.astro';
import InfoSections from '../../../components/InfoSections.astro';
import BuyMeal from '../../../components/BuyMeal.astro';
import { pageProducts, absoluteUrl, band, shortName, officialName, packImage, perPack, mealPath, type Product } from '../../../lib/products';


export function getStaticPaths() {
  return pageProducts.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const img = packImage(p);
const og = img ? await getImage({ src: img, width: 1200, format: 'jpg' }) : null;
const name = shortName(p);
---

<Base title={`${name} — Clean Cut Meals (student concept)`} description={p.description} ogImage={og?.src}>
  <article class="dish" style={`--band: ${band(p)}`}>
    <section class="hero" aria-labelledby="dish-name">
      {img && (
      <div class="hero-photo">
        <Picture
          src={img}
          formats={['avif', 'webp']}
          widths={[300, 600, 900]}
          sizes="220px"
          alt={`${officialName(p)}, 400 g pack`}
          loading="eager"
          fetchpriority="high"
        />
        <p class="caption">Pack image from the SuperValu product page. The bowl on the pack is a serving suggestion.</p>
      </div>
      )}
      <div class:list={['hero-band wrap', { 'hero-band--solo': !img }]}>
        <h1 id="dish-name" class="dish-name">{name}</h1>
        <p class="official">{officialName(p)}</p>
        <p class="desc">{p.description}</p>
      </div>
    </section>

    <section class="facts wrap" aria-label="Key facts, per pack">
      <dl>
        <div><dt>Pack</dt><dd>{p.weight}</dd></div>
        <div><dt>Protein</dt><dd>{perPack(p, 'Protein')}</dd></div>
        <div><dt>Energy</dt><dd>{perPack(p, 'kcal')}</dd></div>
      </dl>
      <p class="claim">Ready in 5 minutes, according to the product card.</p>
    </section>

    <div class="wrap">
      <BuyMeal product={p} />
    </div>

    <section class="wrap act" aria-label="What next">
      <ActionBar path={mealPath(p)} shareUrl={absoluteUrl(mealPath(p), Astro.site)} dishName={name} />
    </section>

    <section class="more" aria-label="More about this meal">
      <InfoSections product={p} />
    </section>
  </article>
</Base>

<style>
  .hero-photo {
    background: var(--paper);
    padding: 0 var(--gutter) var(--s2);
  }
  /* The source photo is square with empty white space above and below the tray.
     A 5:4 window trims only that white space (pack spans rows ~192–1308 of 1500 in all three images);
     the file itself is unchanged and the whole pack stays visible. */
  .hero-photo :global(img) {
    width: 100%;
    max-width: 220px;
    margin: 0 auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: 50% 50%;
  }
  /* Two-tone split from the pack backdrop (brandbook p.21, p.24): solid band colour under the image */
  .hero-band {
    background: var(--band);
    padding-top: 12px;
    padding-bottom: 12px;
  }
  /* Public build without pack photos: the colour band carries the first screen on its own */
  .hero-band--solo {
    padding-top: var(--s5);
    padding-bottom: var(--s5);
  }
  .hero-band > * {
    max-width: var(--measure);
  }
  .dish-name {
    margin: 0;
    font-size: clamp(1.875rem, 8.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .official {
    margin: var(--s1) 0 0;
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .desc {
    margin: var(--s1) 0 0;
    font-size: var(--fs-small);
    line-height: 1.4;
    max-width: var(--measure);
  }
  /* Short screens (e.g. 375×667): smaller pack image and title so the buy buttons reach the first screen.
     Body text and button sizes stay the same. */
  @media (max-height: 700px) {
    .hero-photo :global(img) {
      max-width: 120px;
    }
    .dish-name {
      font-size: 1.75rem;
    }
  }
  .caption {
    max-width: 420px;
    margin: var(--s1) auto 0;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
  .facts {
    padding-top: 12px;
  }
  .facts dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
  }
  .facts dl > div {
    padding: var(--s2);
  }
  .facts dl > div + div {
    border-left: 1px solid var(--rule);
  }
  .facts dt {
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .facts dd {
    margin: var(--s1) 0 0;
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.1;
    white-space: nowrap;
  }
  .claim {
    margin: var(--s2) 0 0;
    font-size: var(--fs-small);
  }
  .act {
    padding-top: var(--s3);
    padding-bottom: var(--s5);
  }
</style>
