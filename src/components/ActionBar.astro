---
interface Share {
  /** Absolute short link when the public address is configured */
  url: string | null;
  /** Short link path (with base), used when url is null (local preview) */
  path: string;
  title: string;
  text: string;
  /** Path of the 1080×1920 meal card */
  card: string;
  cardName: string;
}
interface Props {
  dishName: string;
  mealPath: string;
  share: Share;
}
const { mealPath, share } = Astro.props;
const shownUrl = share.url ?? share.path;
---

<div
  class="actions"
  data-share-root
  data-path={share.path}
  data-url={share.url ?? undefined}
  data-title={share.title}
  data-text={share.text}
  data-card={share.card}
  data-card-name={share.cardName}
>
  <div class="action-row">
    <a class="btn btn--primary" href="#how-to-heat" data-open-heat>How to heat</a>
    <a class="btn" href={`${mealPath}choose/`}>Choose another meal</a>
  </div>
  <div class="action-row share-row-btns">
    <button type="button" class="btn" data-share-link aria-controls="share-panel">Share link</button>
    <button type="button" class="btn" data-share-card aria-controls="share-panel">Share meal card</button>
  </div>

  <div id="share-panel" class="share-panel" data-share-panel hidden>
    <label for="share-url" class="share-label">Link to this meal</label>
    <div class="share-row">
      <input id="share-url" class="share-url" type="text" readonly data-share-url value={shownUrl} />
      <button type="button" class="btn btn--primary share-copy" data-copy-button>Copy link</button>
    </div>
    <p class="share-card-fallback" data-card-fallback hidden>
      This browser can't send images directly.{' '}
      <a data-card-link href={share.card} download={share.cardName} target="_blank" rel="noopener">Open the meal card</a>, save it, then send
      it with the link.
    </p>
  </div>
  <p class="share-status" role="status" aria-live="polite" data-share-status></p>
  <p class="share-tip">Ask whoever you're eating with to reply with the one they'd pick.</p>
  <noscript>
    <p class="share-tip">
      Link to share: <span class="share-noscript">{shownUrl}</span>. <a href={share.card}>Meal card image</a>
    </p>
  </noscript>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // "How to heat" opens its section below instead of jumping to a closed one.
  document.querySelectorAll<HTMLAnchorElement>('[data-open-heat]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const section = document.getElementById('how-to-heat') as HTMLDetailsElement | null;
      if (!section) return;
      event.preventDefault();
      section.open = true;
      section.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      section.querySelector('summary')?.focus({ preventScroll: true });
    });
  });

  function initShare(root: HTMLElement) {
    const linkBtn = root.querySelector<HTMLButtonElement>('[data-share-link]')!;
    const cardBtn = root.querySelector<HTMLButtonElement>('[data-share-card]')!;
    const panel = root.querySelector<HTMLElement>('[data-share-panel]')!;
    const input = root.querySelector<HTMLInputElement>('[data-share-url]')!;
    const copy = root.querySelector<HTMLButtonElement>('[data-copy-button]')!;
    const cardFallback = root.querySelector<HTMLElement>('[data-card-fallback]')!;
    const status = root.querySelector<HTMLElement>('[data-share-status]')!;
    const url = root.dataset.url || new URL(root.dataset.path!, window.location.origin).href;
    const title = root.dataset.title!;
    const text = root.dataset.text!;
    input.value = url;

    const say = (msg: string) => {
      status.textContent = '';
      // Set on the next frame so a repeated message is announced again.
      requestAnimationFrame(() => (status.textContent = msg));
    };
    const openPanel = (withCardHelp: boolean) => {
      panel.hidden = false;
      cardFallback.hidden = !withCardHelp;
    };
    const copyLink = async () => {
      try {
        if (!navigator.clipboard) throw new Error('no clipboard');
        await navigator.clipboard.writeText(url);
        say('Link copied');
      } catch {
        input.focus();
        input.select();
        say('Copy the selected link.');
      }
    };
    const isAbort = (err: unknown) => (err as DOMException)?.name === 'AbortError';

    linkBtn.addEventListener('click', async () => {
      const data = { title, text, url };
      if (typeof navigator.share === 'function' && (!navigator.canShare || navigator.canShare(data))) {
        try {
          await navigator.share(data);
          say('Shared.');
        } catch (err) {
          // Closing the share sheet is a normal choice, not an error.
          if (!isAbort(err)) {
            openPanel(false);
            await copyLink();
          }
        }
        return;
      }
      openPanel(false);
      await copyLink();
    });

    // The card is fetched once, only when the person is about to share it (no download on page load).
    let cardFile: Promise<File | null> | null = null;
    const getCard = () =>
      (cardFile ??= fetch(root.dataset.card!)
        .then((r) => (r.ok ? r.blob() : Promise.reject(r.status)))
        .then((b) => new File([b], root.dataset.cardName!, { type: 'image/jpeg' }))
        .catch(() => null));
    ['pointerdown', 'focus'].forEach((type) => cardBtn.addEventListener(type, () => void getCard(), { once: true }));

    cardBtn.addEventListener('click', async () => {
      const file = await getCard();
      // Some apps drop `url` when files are attached, so the link also goes in the text.
      const data = file ? { files: [file], title, text: `${text} ${url}` } : null;
      const canShareFiles =
        !!data && typeof navigator.share === 'function' && typeof navigator.canShare === 'function' && navigator.canShare(data);
      if (canShareFiles) {
        try {
          await navigator.share(data!);
          say('Shared.');
          return;
        } catch (err) {
          if (isAbort(err)) return;
        }
      }
      openPanel(true);
      // The panel explains what to do; move focus there so it's read out once.
      root.querySelector<HTMLAnchorElement>('[data-card-link]')!.focus();
    });

    copy.addEventListener('click', copyLink);
  }

  document.querySelectorAll<HTMLElement>('[data-share-root]').forEach(initShare);
</script>

<style>
  .action-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s2);
  }
  .action-row + .action-row {
    margin-top: var(--s2);
  }
  .action-row .btn {
    min-height: 56px;
    padding: var(--s1) var(--s2);
    font-size: var(--fs-small);
    text-align: center;
    line-height: 1.15;
  }
  .share-panel {
    margin-top: var(--s3);
  }
  .share-label {
    display: block;
    margin-bottom: var(--s2);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .share-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--s2);
  }
  .share-url {
    min-width: 0;
    min-height: 52px;
    padding: var(--s2) var(--s3);
    border: 2px solid var(--ink);
    border-radius: 0;
    font: 400 var(--fs-small) / 1.2 var(--font);
    color: var(--ink);
    background: var(--surface);
  }
  .share-copy {
    width: auto;
    white-space: nowrap;
  }
  .share-card-fallback {
    margin: var(--s3) 0 0;
    font-size: var(--fs-small);
  }
  .share-status {
    margin: var(--s2) 0 0;
    font-weight: 600;
  }
  .share-status:empty {
    display: none;
  }
  .share-tip {
    margin: var(--s3) 0 0;
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .share-noscript {
    word-break: break-all;
  }
</style>
