---
// Review the picks on this device, then send them in one go: a picture card of the products (src/lib/picks-card.ts)
// with "These would be lovely." / link to the whole list (/picks/view/?p=…) / "Thank you ❤️"; where pictures cannot be
// shared, the full list as text plus "Download picture". A wish list only: no prices, order, payment or delivery.
import Base from '../../layouts/Base.astro';
import PickRow from '../../components/PickRow.astro';
import PicksData from '../../components/PicksData.astro';
import { products, withBase } from '../../lib/products';
---

<Base title="Your picks — Clean Cut Meals" description="Review the products you picked and send the list.">
  <div class="review">
    <div class="wrap">
      <h1 class="title" id="review-title" tabindex="-1">Your picks</h1>
      <p class="sum" data-sum aria-live="polite"></p>
    </div>

    <ul class="list" aria-labelledby="review-title" data-list>
      {products.map((p) => <PickRow product={p} mode="edit" />)}
    </ul>

    <div class="wrap empty" data-empty hidden>
      <p>Nothing on your list yet.</p>
      <a class="btn btn--primary" href={withBase('/picks/')}>Choose a few things</a>
    </div>

    <div class="wrap actions" data-actions hidden>
      <button type="button" class="btn btn--primary send-btn" data-send aria-describedby="send-sub">Send my picks</button>
      <p class="send-sub" id="send-sub">Opens your share menu with a picture of your picks. You choose who to send it to.</p>
      <p class="send-note" data-note hidden></p>
      <div class="send-panel" data-panel hidden>
        <label for="picks-msg" class="send-label">Copy this message</label>
        <textarea id="picks-msg" class="send-msg" rows="8" readonly data-box></textarea>
      </div>
      <p class="send-status" role="status" aria-live="polite" data-status></p>
      <div class="downloads" data-downloads hidden></div>
      <a class="btn keep" href={withBase('/picks/')}>Keep choosing</a>

      <div class="clear">
        <button type="button" class="clear-btn" data-clear aria-expanded="false" aria-controls="clear-confirm">Clear all</button>
        <div class="clear-confirm" id="clear-confirm" data-confirm hidden>
          <p>Remove everything from your list?</p>
          <div class="clear-row">
            <button type="button" class="btn" data-clear-yes>Yes, clear all</button>
            <button type="button" class="btn" data-clear-no>Cancel</button>
          </div>
        </div>
      </div>
    </div>
    <noscript><p class="wrap">Your picks need JavaScript in your browser.</p></noscript>
  </div>
  <PicksData />
</Base>

<script>
  import {
    captionMessage, changePacks, encodePicks, loadDraft, picksMessage, readPicksData, saveDraft, summaryLabel, unitLabel, MAX_PACKS,
    type Pick,
  } from '../../lib/picks';
  import { renderPicksPictures } from '../../lib/picks-card';

  const data = readPicksData();
  const list = document.querySelector<HTMLElement>('[data-list]')!;
  const rows = new Map([...list.querySelectorAll<HTMLElement>('[data-pick]')].map((el) => [el.dataset.pick!, el]));
  const sum = document.querySelector<HTMLElement>('[data-sum]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const actions = document.querySelector<HTMLElement>('[data-actions]')!;
  const panel = document.querySelector<HTMLElement>('[data-panel]')!;
  const box = document.querySelector<HTMLTextAreaElement>('[data-box]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const title = document.getElementById('review-title')!;
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]')!;
  const confirmBox = document.querySelector<HTMLElement>('[data-confirm]')!;
  const sendBtn = document.querySelector<HTMLButtonElement>('[data-send]')!;
  const note = document.querySelector<HTMLElement>('[data-note]')!;
  const downloads = document.querySelector<HTMLElement>('[data-downloads]')!;
  let picks: Pick[] = [];

  const message = () => picksMessage(picks, data.byId, data.viewUrl);

  // Can this browser share image files at all? canShare needs no tap; true does not promise how an app shows them.
  const probe = (() => {
    try {
      return new File([new Uint8Array([0xff, 0xd8, 0xff, 0xd9])], 'probe.jpg', { type: 'image/jpeg' });
    } catch {
      return null;
    }
  })();
  const canShareFiles =
    typeof navigator.share === 'function' &&
    typeof navigator.canShare === 'function' &&
    !!probe &&
    (() => {
      try {
        return navigator.canShare({ files: [probe], text: 'x' });
      } catch {
        return false;
      }
    })();

  // Pictures are made ahead, every time the list changes, so the tap can open the share sheet at once
  // (share() must run while the tap still counts). `prepared.key` ties them to exactly this list.
  let prepared: { key: string; files: File[]; urls: string[] } | null = null;
  let failedKey: string | null = null;
  let job = 0;
  let downloadsWanted = !canShareFiles;

  function showDownloads() {
    downloads.replaceChildren();
    const ready = prepared && prepared.key === encodePicks(picks);
    downloads.hidden = !(downloadsWanted && ready);
    if (!ready) return;
    prepared!.urls.forEach((url, i, all) => {
      const a = document.createElement('a');
      a.className = 'btn download';
      a.href = url;
      a.download = prepared!.files[i].name;
      a.textContent = all.length === 1 ? 'Download picture' : `Download picture ${i + 1}`;
      downloads.append(a);
    });
  }

  function prepare() {
    const key = encodePicks(picks);
    if (prepared?.key === key) return;
    if (prepared) prepared.urls.forEach((u) => URL.revokeObjectURL(u));
    prepared = null;
    failedKey = null;
    note.hidden = true;
    showDownloads();
    if (!picks.length) return;
    const mine = ++job;
    // Until the pictures for this exact list are ready, the button waits (normally well under a second).
    sendBtn.disabled = canShareFiles;
    renderPicksPictures(picks, data.byId)
      .then((blobs) => {
        if (mine !== job) return;
        const files = blobs.map(
          (b, i) => new File([b], blobs.length === 1 ? 'these-would-be-lovely.jpg' : `these-would-be-lovely-${i + 1}.jpg`, { type: 'image/jpeg' }),
        );
        prepared = { key, files, urls: blobs.map((b) => URL.createObjectURL(b)) };
      })
      .catch(() => {
        if (mine !== job) return;
        failedKey = key;
        note.textContent = 'Couldn’t make the picture. Your list will be sent as text.';
        note.hidden = false;
      })
      .finally(() => {
        if (mine !== job) return;
        sendBtn.disabled = false;
        showDownloads();
      });
  }

  function render() {
    for (const [id, el] of rows) {
      const packs = picks.find((p) => p.id === id)?.packs ?? 0;
      el.hidden = packs === 0;
      if (!packs) continue;
      const name = data.byId.get(id)!.name;
      el.querySelector<HTMLElement>('[data-add]')!.hidden = true;
      el.querySelector<HTMLElement>('[data-row]')!.hidden = false;
      const unit = data.byId.get(id)!.unit;
      el.querySelector<HTMLElement>('[data-count]')!.textContent = unitLabel(packs, unit);
      el.querySelector<HTMLButtonElement>('[data-plus]')!.disabled = packs >= MAX_PACKS;
      el.querySelector<HTMLElement>('[data-minus]')!.setAttribute(
        'aria-label',
        packs === 1 ? `Remove ${name} from my picks` : `One ${unit} fewer of ${name}`,
      );
      el.querySelector<HTMLElement>('[data-plus]')!.setAttribute('aria-label', `One more ${unit} of ${name}`);
    }
    // Same order as the message: the order things were added in.
    for (const p of picks) list.append(rows.get(p.id)!);
    sum.textContent = picks.length ? summaryLabel(picks) : '';
    empty.hidden = picks.length > 0;
    actions.hidden = picks.length === 0;
    // A copy box left open from an earlier attempt must not show an old list.
    box.value = picks.length ? message() : '';
    prepare();
  }

  function change(id: string, delta: number) {
    picks = changePacks(loadDraft(data.known), id, delta);
    saveDraft(picks);
    status.textContent = '';
    render();
    // The row is gone: keep focus on the page instead of losing it with the removed buttons.
    if (!picks.some((p) => p.id === id)) title.focus();
  }

  for (const [id, el] of rows) {
    el.querySelector('[data-plus]')!.addEventListener('click', () => change(id, 1));
    el.querySelector('[data-minus]')!.addEventListener('click', () => change(id, -1));
    el.querySelector('[data-remove]')!.addEventListener('click', () => change(id, -MAX_PACKS));
  }

  const say = (msg: string) => {
    status.textContent = '';
    // Set on the next frame so a repeated message is announced again.
    requestAnimationFrame(() => (status.textContent = msg));
  };
  const copy = async (text: string) => {
    try {
      if (!navigator.clipboard) throw new Error('no clipboard');
      await navigator.clipboard.writeText(text);
      say('Message copied. Paste it into your chat.');
    } catch {
      box.value = text;
      panel.hidden = false;
      box.focus();
      box.select();
      say('Copy the selected message.');
    }
  };

  // Opens the share sheet straight from the tap (the first await in the handler is share() itself, so the tap still
  // counts). With pictures: the files + a short text (heading, link, thanks). Without: the full list as text, and
  // "Download picture" appears. Closing or finishing the sheet clears nothing: the site cannot know what was sent.
  sendBtn.addEventListener('click', async () => {
    if (!picks.length) return;
    const key = encodePicks(picks);
    const full = message();
    if (canShareFiles && prepared?.key === key && failedKey !== key) {
      const withPictures: ShareData = { files: prepared.files, text: captionMessage(picks, data.byId, data.viewUrl) };
      if (navigator.canShare(withPictures)) {
        status.textContent = '';
        try {
          await navigator.share(withPictures);
        } catch (err) {
          // Cancel: nothing else happens. Other failures: the text list to copy, and the pictures to download.
          if ((err as DOMException).name !== 'AbortError') {
            downloadsWanted = true;
            showDownloads();
            await copy(full);
          }
        }
        return;
      }
    }
    downloadsWanted = true;
    showDownloads();
    const textOnly: ShareData = { text: full };
    if (typeof navigator.share === 'function' && (!navigator.canShare || navigator.canShare(textOnly))) {
      try {
        await navigator.share(textOnly);
      } catch (err) {
        if ((err as DOMException).name !== 'AbortError') await copy(full);
      }
      return;
    }
    await copy(full);
  });

  const closeConfirm = (focus: boolean) => {
    confirmBox.hidden = true;
    clearBtn.setAttribute('aria-expanded', 'false');
    if (focus) clearBtn.focus();
  };
  clearBtn.addEventListener('click', () => {
    const open = confirmBox.hidden;
    confirmBox.hidden = !open;
    clearBtn.setAttribute('aria-expanded', String(open));
    if (open) confirmBox.querySelector<HTMLElement>('[data-clear-no]')!.focus();
  });
  confirmBox.querySelector('[data-clear-no]')!.addEventListener('click', () => closeConfirm(true));
  confirmBox.querySelector('[data-clear-yes]')!.addEventListener('click', () => {
    picks = [];
    saveDraft(picks);
    closeConfirm(false);
    panel.hidden = true;
    status.textContent = '';
    render();
    empty.querySelector<HTMLElement>('a')!.focus();
  });

  const refresh = () => {
    picks = loadDraft(data.known);
    render();
  };
  refresh();
  window.addEventListener('pageshow', refresh);
</script>

<style>
  .title {
    margin: var(--s2) 0 var(--s1);
    font-size: var(--fs-h2);
    line-height: 1.1;
  }
  .title:focus {
    outline: none;
  }
  .sum {
    margin: 0 0 var(--s3);
    font-weight: 700;
  }
  .sum:empty {
    display: none;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .empty {
    padding-top: var(--s3);
  }
  .empty[hidden],
  .actions[hidden] {
    display: none;
  }
  .empty p {
    margin: 0 0 var(--s3);
  }
  .actions {
    padding-top: var(--s4);
  }
  .send-btn {
    min-height: 60px;
    font-size: var(--fs-h3);
    font-weight: 700;
  }
  .send-sub {
    margin: var(--s2) 0 0;
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .send-panel {
    margin-top: var(--s3);
  }
  .send-label {
    display: block;
    margin-bottom: var(--s2);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .send-msg {
    width: 100%;
    padding: var(--s2) var(--s3);
    border: 2px solid var(--ink);
    border-radius: 0;
    font: 400 var(--fs-small) / 1.35 var(--font);
    color: var(--ink);
    background: var(--surface);
    resize: none;
  }
  .send-note {
    margin: var(--s2) 0 0;
    font-size: var(--fs-small);
  }
  .send-note[hidden],
  .downloads[hidden] {
    display: none;
  }
  .send-btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .downloads {
    display: grid;
    gap: var(--s2);
    margin-top: var(--s3);
  }
  .send-status {
    margin: var(--s2) 0 0;
    font-weight: 600;
  }
  .send-status:empty {
    display: none;
  }
  .keep {
    margin-top: var(--s3);
  }
  .clear {
    margin-top: var(--s4);
  }
  .clear-btn {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: 600 var(--fs-small) / 1.2 var(--font);
    text-decoration: underline;
    cursor: pointer;
  }
  .clear-confirm {
    margin-top: var(--s2);
    padding: var(--s3);
    border: 2px solid var(--ink);
  }
  .clear-confirm[hidden] {
    display: none;
  }
  .clear-confirm p {
    margin: 0 0 var(--s2);
    font-weight: 600;
  }
  .clear-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s2);
  }
</style>
