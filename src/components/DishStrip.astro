---
import { Picture } from 'astro:assets';
import { band, shortName, packImage, perPack, mealPath, type Product } from '../lib/products';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
  /** Link target; defaults to the standard meal page */
  href?: string;
}
const { product: p, headingLevel = 'h2', href } = Astro.props;
const Heading = headingLevel;
const img = packImage(p);
---

<a class:list={['strip', { 'strip--text': !img }]} href={href ?? mealPath(p)} style={`--band: ${band(p)}`}>
  {img && <Picture
    src={img}
    formats={['avif', 'webp']}
    widths={[112, 224]}
    sizes="112px"
    alt=""
    class="strip-img"
  />}
  <div class="strip-text">
    <Heading class="strip-name">{shortName(p)}</Heading>
    <p class="strip-facts">
      <span>{p.size}</span>
      {perPack(p, 'Protein') && <span>{perPack(p, 'Protein')} protein</span>}
      {perPack(p, 'kcal') && <span>{perPack(p, 'kcal')}</span>}
    </p>
  </div>
</a>

<style>
  .strip {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: var(--s3);
    align-items: start;
    padding: var(--s3) var(--gutter) var(--s3) calc(var(--gutter) - 2px);
    border-left: 10px solid var(--band);
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    background: var(--paper);
  }
  .strip--text {
    grid-template-columns: 1fr;
  }
  .strip:hover .strip-name,
  .strip:focus-visible .strip-name {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  /* Fixed width, height from the file's own ratio (trimmed pack photos are ~1.27:1, not square).
     The 112px grid column never shrinks, so neighbouring text can't squeeze the image. */
  .strip :global(.strip-img) {
    display: block;
    width: 112px;
    max-width: none;
    height: auto;
  }
  .strip-name {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .strip-desc {
    margin: var(--s2) 0 0;
    font-size: var(--fs-small);
  }
  .strip-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s3);
    margin: var(--s2) 0 0;
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .strip-allergens {
    margin: var(--s1) 0 0;
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
</style>
