---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { orderLinks, demoServices, type Product, type ServiceStyle } from '../lib/products';

interface Props {
  product: Product;
  dishName: string;
}
const { product, dishName } = Astro.props;
const links = orderLinks(product);
const demos = demoServices(product);

// Official retailer logos (sources in data/order-links.json → services). Files are shown unchanged, aspect ratio kept.
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/retailers/*.{svg,png}', { eager: true });
function logoFor(s: ServiceStyle): ImageMetadata | null {
  return logoFiles[`../../${s.logo}`]?.default ?? null;
}
// App icons are square and carry the name only in small type, so the name is also written out.
const isIcon = (s: ServiceStyle) => s.logo.endsWith('.png');
---

<section class="buy" id="buy" aria-labelledby="buy-title">
  <h2 id="buy-title" class="buy-title">Buy this meal</h2>
  <ul class="buy-list">
    {
      links.map((l) => {
        const logo = logoFor(l);
        return (
          <li>
            <a
              class="svc"
              href={l.url}
              rel="noopener noreferrer"
              target="_blank"
              style={`--svc-bg: ${l.bg}; --svc-fg: ${l.fg}`}
              aria-label={`${l.serviceName}: ${l.label} (opens in a new tab)`}
            >
              <span class:list={['svc-logo', `svc-logo--${l.service}`, { 'svc-logo--icon': isIcon(l) }]}>
                {logo ? <Image src={logo} alt="" height={64} /> : l.serviceName}
              </span>
              <span class="svc-text">
                {isIcon(l) && <span class="svc-name">{l.serviceName}</span>}
                <span class="svc-action">{l.label}</span>
              </span>
              <svg class="svc-ext" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <path d="M6 3H3v10h10v-3M9 2h5v5M14 2 7 9" fill="none" stroke="currentColor" stroke-width="1.8" />
              </svg>
            </a>
          </li>
        );
      })
    }
    {
      demos.map((d) => {
        const logo = logoFor(d);
        return (
          <li>
            <button
              type="button"
              class="svc"
              data-demo-open={`demo-${d.service}`}
              style={`--svc-bg: ${d.bg}; --svc-fg: ${d.fg}`}
              aria-haspopup="dialog"
              aria-label={`${d.serviceName}: ${d.label}`}
            >
              <span class:list={['svc-logo', `svc-logo--${d.service}`, { 'svc-logo--icon': isIcon(d) }]}>
                {logo ? <Image src={logo} alt="" height={64} /> : d.serviceName}
              </span>
              <span class="svc-text">
                <span class="svc-name">
                  {isIcon(d) && d.serviceName} <span class="svc-tag">Demo</span>
                </span>
                <span class="svc-action">{d.label}</span>
              </span>
            </button>
            <dialog id={`demo-${d.service}`} class="demo" aria-labelledby={`demo-${d.service}-title`}>
              <h3 id={`demo-${d.service}-title`} class="demo-title">Choose a participating store — demo</h3>
              <p>
                This is a demo for the student showcase. We haven't confirmed which {d.serviceName} stores list {dishName},
                so there's no store or meal link here.
              </p>
              <p class="demo-note">In a real version, you'd pick a nearby store that stocks this meal.</p>
              <form method="dialog">
                <button type="submit" class="btn btn--primary">Close</button>
              </form>
            </dialog>
          </li>
        );
      })
    }
  </ul>
  <p class="buy-note">Availability and delivery depend on your location.</p>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-demo-open]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.demoOpen!) as HTMLDialogElement | null;
    if (!dialog) return;
    button.addEventListener('click', () => dialog.showModal());
    // Tap outside the box closes it too.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .buy {
    padding-top: var(--s3);
  }
  .buy-title {
    margin: 0 0 var(--s2);
    font-size: var(--fs-body);
    font-weight: 700;
  }
  .buy-list {
    display: grid;
    gap: var(--s2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Each service keeps its own colours; the CCM frame is the heading, spacing and note around them. */
  .svc {
    display: grid;
    grid-template-columns: 124px 1fr auto;
    align-items: center;
    gap: var(--s3);
    width: 100%;
    min-height: 60px;
    padding: var(--s2) var(--s3);
    border: 0;
    border-radius: 10px;
    background: var(--svc-bg);
    color: var(--svc-fg);
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .svc:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .svc:active {
    transform: translateY(1px);
  }
  .svc-logo {
    display: flex;
    align-items: center;
    height: 32px;
    font-weight: 700;
  }
  .svc-logo :global(img) {
    display: block;
    width: auto;
    max-width: 112px;
    height: 32px;
    object-fit: contain;
    object-position: left center;
  }
  /* App icon: shown whole with the rounded corners of an app tile */
  /* The Uber Eats file has green clear space built in (brand rule), so it is shown taller. */
  .svc-logo--uber_eats {
    height: 44px;
  }
  .svc-logo--uber_eats :global(img) {
    height: 44px;
    max-width: 124px;
  }
  /* App icon: rounded tile; the store artwork's light edge falls outside the clip. */
  .svc-logo--icon {
    width: 40px;
    height: 40px;
    overflow: hidden;
    border-radius: 9px;
  }
  .svc-logo--icon :global(img) {
    width: 40px;
    height: 40px;
    transform: scale(1.06);
  }
  .svc-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .svc-name {
    font-weight: 700;
    line-height: 1.2;
  }
  .svc-action {
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1.25;
  }
  .svc-tag {
    display: inline-block;
    margin-left: var(--s1);
    padding: 0 8px;
    vertical-align: 2px;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .buy-note {
    margin: var(--s2) 0 0;
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .demo {
    max-width: min(26rem, calc(100vw - 2 * var(--gutter)));
    padding: var(--s4);
    border: 2px solid var(--ink);
    border-radius: 10px;
    color: var(--ink);
    background: var(--paper);
  }
  .demo::backdrop {
    background: rgb(36 1 76 / 0.45);
  }
  .demo-title {
    margin: 0 0 var(--s3);
    font-size: var(--fs-h3);
    line-height: 1.2;
  }
  .demo p {
    margin: 0 0 var(--s3);
  }
  .demo-note {
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .demo form {
    margin: 0;
  }
</style>
