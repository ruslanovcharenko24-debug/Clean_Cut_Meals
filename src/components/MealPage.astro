---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BuyMeal from './BuyMeal.astro';
import SendButton from './SendButton.astro';
import InfoSections from './InfoSections.astro';
import {
  absoluteUrl, band, shortName, officialName, packImage, perPack, mealPath, invitePath, pickPath, cardPath,
  INVITE_TEXT, REPLY_TEXT, type MealMode, type Product,
} from '../lib/products';

// One meal page in three modes, all static so link previews read their own tags without JavaScript:
//   standard  /meals/<slug>/ and /s/<short>/   order for yourself + invite someone
//   invite    /invite/<short>/                  recipient picks: "This one for me" or another meal
//   pick      /pick/<short>/                    the meal someone picked, sent back to the inviter
interface Props {
  product: Product;
  /** Path this copy is served at; used for og:url. */
  path: string;
  mode?: MealMode;
}
const { product: p, path, mode = 'standard' } = Astro.props;
const img = packImage(p);
const name = shortName(p);
const protein = perPack(p, 'Protein');
const kcal = perPack(p, 'kcal');

const PREVIEW_TITLE: Record<MealMode, string> = {
  standard: 'View meal & order',
  invite: 'What would you like?',
  pick: 'This one for me, please',
};
const chooseHref = mode === 'invite' ? `${invitePath(p)}choose/` : `${mealPath(p)}choose/`;
const BUY_HEADING: Record<MealMode, string> = {
  standard: 'Order for yourself',
  invite: 'Or order it yourself',
  pick: 'Order this meal',
};
---

<Base
  title={`${name} — Clean Cut Meals (student concept)`}
  description={p.description}
  preview={{
    title: PREVIEW_TITLE[mode],
    description: 'Student concept — not an official Clean Cut Meals service.',
    image: cardPath(p),
    imageAlt: `${name}: Clean Cut Meals pack, ${protein} protein, ${kcal}, ${p.weight} pack.`,
    url: path,
    canonical: mealPath(p),
  }}
>
  <article class:list={['dish', `dish--${mode}`]} style={`--band: ${band(p)}`}>
    {mode === 'invite' && <p class="mode-head">What would you like?</p>}
    {mode === 'pick' && <p class="mode-head">This one for me, please</p>}

    <section class="hero" aria-labelledby="dish-name">
      {img && (
      <div class="hero-photo">
        <Picture
          src={img}
          formats={['avif', 'webp']}
          widths={[300, 600, 900]}
          sizes="220px"
          alt={`${officialName(p)}, 400 g pack`}
          loading="eager"
          fetchpriority="high"
        />
        <p class="caption">Pack photo from SuperValu. The bowl on the pack is a serving suggestion.</p>
      </div>
      )}
      <div class:list={['hero-band wrap', { 'hero-band--solo': !img }]}>
        <h1 id="dish-name" class="dish-name">{name}</h1>
      </div>
    </section>

    <section class="facts wrap" aria-label="Key facts, per pack">
      <dl>
        <div><dt>Pack</dt><dd>{p.weight}</dd></div>
        <div><dt>Protein</dt><dd>{protein}</dd></div>
        <div><dt>Energy</dt><dd>{kcal}</dd></div>
      </dl>
    </section>

    {
      mode === 'invite' ? (
        <div class="wrap primary">
          <SendButton
            id="reply"
            label="This one for me"
            sub="Opens your messages so you can send this meal back."
            text={REPLY_TEXT}
            url={absoluteUrl(pickPath(p), Astro.site)}
            path={pickPath(p)}
          />
          <a class="btn btn-secondary-wide" href={chooseHref}>Choose another meal</a>
          <BuyMeal product={p} dishName={name} heading={BUY_HEADING[mode]} />
        </div>
      ) : (
        <div class="wrap">
          <BuyMeal product={p} dishName={name} heading={BUY_HEADING[mode]} />
          {mode === 'standard' && (
            <div class="primary">
              <SendButton
                id="invite"
                label="What would you like?"
                sub="Choose a meal for lunch or dinner. I can pick it up for you, or you can order yours."
                text={INVITE_TEXT}
                url={absoluteUrl(invitePath(p), Astro.site)}
                path={invitePath(p)}
              />
            </div>
          )}
        </div>
      )
    }

    <section class="wrap dish-about" aria-label="About this meal">
      <p class="official">{officialName(p)}</p>
      <p class="desc">{p.description}</p>
      <p class="claim">Ready in 5 minutes, according to the product card.</p>
    </section>

    <nav class="wrap secondary" aria-label="More options">
      <a class="btn btn--small" href="#how-to-heat" data-open-heat>How to heat</a>
      {mode !== 'invite' && <a class="btn btn--small" href={chooseHref}>Choose another meal</a>}
    </nav>

    <section class="more" aria-label="More about this meal">
      <InfoSections product={p} />
    </section>
  </article>
</Base>

<script>
  // "How to heat" opens its section below instead of jumping to a closed one.
  document.querySelectorAll<HTMLAnchorElement>('[data-open-heat]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const section = document.getElementById('how-to-heat') as HTMLDetailsElement | null;
      if (!section) return;
      event.preventDefault();
      section.open = true;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      section.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      section.querySelector('summary')?.focus({ preventScroll: true });
    });
  });
</script>

<style>
  .mode-head {
    margin: 0;
    padding: var(--s2) var(--gutter) var(--s3);
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.1;
  }
  .primary {
    padding-top: var(--s4);
  }
  .dish--invite .primary {
    padding-top: var(--s3);
  }
  .btn-secondary-wide {
    margin-top: var(--s2);
    min-height: 52px;
  }
  .secondary {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s2);
    padding-top: var(--s4);
    padding-bottom: var(--s5);
  }
  .btn--small {
    min-height: 48px;
    padding: var(--s1) var(--s2);
    font-size: var(--fs-small);
    text-align: center;
    line-height: 1.15;
  }
  .hero-photo {
    background: var(--paper);
    padding: 0 var(--gutter) var(--s2);
  }
  /* The source photo is square with empty white space above and below the tray.
     A 5:4 window trims only that white space (pack spans rows ~192–1308 of 1500 in all three images);
     the file itself is unchanged and the whole pack stays visible. */
  .hero-photo :global(img) {
    width: 100%;
    max-width: 220px;
    margin: 0 auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: 50% 50%;
  }
  /* Two-tone split from the pack backdrop (brandbook p.21, p.24): solid band colour under the image */
  .hero-band {
    background: var(--band);
    padding-top: 12px;
    padding-bottom: 12px;
  }
  /* Public build without pack photos: the colour band carries the first screen on its own */
  .hero-band--solo {
    padding-top: var(--s5);
    padding-bottom: var(--s5);
  }
  .hero-band > * {
    max-width: var(--measure);
  }
  .dish-name {
    margin: 0;
    font-size: clamp(1.875rem, 8.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .dish-about {
    padding-top: var(--s4);
  }
  .official {
    margin: 0;
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .desc {
    margin: var(--s1) 0 0;
    font-size: var(--fs-small);
    line-height: 1.4;
    max-width: var(--measure);
  }
  /* Short screens (e.g. 375×667): smaller pack image and title so the buy buttons reach the first screen.
     Body text and button sizes stay the same. */
  @media (max-height: 700px) {
    .hero-photo :global(img) {
      max-width: 120px;
    }
    .dish-name {
      font-size: 1.75rem;
    }
  }
  .caption {
    max-width: 420px;
    margin: var(--s1) auto 0;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
  .facts {
    padding-top: 12px;
  }
  .facts dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
  }
  .facts dl > div {
    padding: var(--s2);
  }
  .facts dl > div + div {
    border-left: 1px solid var(--rule);
  }
  .facts dt {
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .facts dd {
    margin: var(--s1) 0 0;
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.1;
    white-space: nowrap;
  }
  .claim {
    margin: var(--s2) 0 0;
    font-size: var(--fs-small);
  }
</style>
