---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import fontUrl from '../assets/fonts/lexend-latin.woff2?url';
import { DATA_DATE_LABEL, withBase, absoluteUrl, CREATOR } from '../lib/products';

// The logo file is not in the public repository (rights not confirmed); a plain text name replaces it there.
const logos = import.meta.glob<{ default: ImageMetadata }>('../../assets/brand/ccm-logo.png', { eager: true });
const logo = Object.values(logos)[0]?.default ?? null;

interface Preview {
  title: string;
  description: string;
  /** Site path (with base) of a 1200×630 JPEG */
  image: string;
  imageAlt: string;
  /** Site path this copy is served at */
  url: string;
  canonical?: string;
}
interface Props {
  title: string;
  description: string;
  preview?: Preview;
}

const { title, description, preview } = Astro.props;
// Link-preview tags are plain HTML so messenger crawlers read them without running JavaScript.
const pageUrl = absoluteUrl(preview?.url ?? Astro.url.pathname, Astro.site);
const canonicalUrl = absoluteUrl(preview?.canonical ?? preview?.url ?? Astro.url.pathname, Astro.site);
const ogTitle = preview?.title ?? title;
const ogDescription = preview?.description ?? description;
const ogImageUrl = preview && Astro.site ? new URL(preview.image, Astro.site).href : null;
const DISCLAIMER = 'Student concept for MTU Brand Challenge — not an official Clean Cut Meals service.';
---

<!doctype html>
<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Clean Cut Meals — student concept" />
    <meta property="og:locale" content="en_IE" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:secure_url" content={ogImageUrl} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={preview!.imageAlt} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={preview!.imageAlt} />}
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="page">
      <header class="site-header">
        <a href={withBase('/')} class="logo-link" aria-label="Clean Cut Meals prototype home">
          {
            logo ? (
              <Image src={logo} alt="Clean Cut Meals" width={256} loading="eager" class="logo" />
            ) : (
              <span class="text-mark">Clean Cut Meals <span class="text-mark-note">prototype</span></span>
            )
          }
        </a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer wrap" id="site-footer">
        <section class="creator" aria-labelledby="creator-title">
          <h2 id="creator-title" class="creator-title">Have a project in mind?</h2>
          <p class="creator-lead">Interested in using or developing this concept? Contact its creator.</p>
          <p class="creator-credit">Original idea, concept and creative direction by Ruslan Ovcharenko.</p>
          <ul class="creator-contacts">
            <li><a href={`mailto:${CREATOR.email}`}>{CREATOR.email}</a></li>
            <li><a href={`tel:${CREATOR.phoneHref}`}>{CREATOR.phone}</a></li>
          </ul>
          <a class="btn creator-btn" href={`mailto:${CREATOR.email}`}>Contact the creator</a>
        </section>
        <p><strong>{DISCLAIMER}</strong> Not a SuperValu service either.</p>
        <p>
          Product info from SuperValu product pages, data as of {DATA_DATE_LABEL}. Always check the pack, especially if you have
          an allergy.
        </p>
        <p><a href={withBase('/about/')}>About this prototype and its sources</a></p>
        <p class="copyright">
          © 2026 Ruslan Ovcharenko. All rights reserved in his original contributions to this prototype. Third-party
          trademarks, images and software remain subject to their respective owners' rights and licences.
        </p>
      </footer>
    </div>
  </body>
</html>

<style>
  .concept-bar {
    margin: 0;
    padding: 4px var(--gutter);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .concept-bar a {
    color: inherit;
  }
  .text-mark {
    display: inline-block;
    font-size: var(--fs-h3);
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
  }
  .text-mark-note {
    font-weight: 400;
    color: var(--ink-soft);
  }
  .site-header {
    /* Logo clearance: at least the height of the logo's "e" on every side (brandbook p.11) */
    padding: 0 var(--gutter);
  }
  .logo-link {
    text-decoration: none;
    display: inline-block;
    padding: 10px; /* ≈ height of the logo's “e” at 128px */
    margin-left: -10px;
  }
  .logo {
    width: 128px; /* digital minimum is 120px (brandbook p.11) */
    height: auto;
  }
  .site-footer {
    margin-top: var(--s6);
    padding-top: var(--s4);
    padding-bottom: var(--s5);
    border-top: 1px solid var(--rule);
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .site-footer p {
    margin: 0 0 var(--s2);
    max-width: var(--measure);
  }
  .site-footer strong {
    color: var(--ink);
  }
  /* Creator block: the one dark panel on the page, after all meal and order content. */
  .creator {
    margin: 0 0 var(--s4);
    padding: var(--s4) var(--s3);
    border-radius: 10px;
    background: var(--ink);
    color: var(--paper);
  }
  .site-footer .creator p {
    max-width: var(--measure);
  }
  .creator-title {
    margin: 0 0 var(--s2);
    font-size: var(--fs-h3);
    line-height: 1.2;
    color: var(--paper);
  }
  .site-footer .creator-lead {
    margin: 0 0 var(--s3);
    font-size: var(--fs-body);
    color: var(--paper);
  }
  .site-footer .creator-credit {
    margin: 0 0 var(--s3);
    color: var(--accent);
    font-weight: 600;
  }
  .creator-contacts {
    margin: 0 0 var(--s3);
    padding: 0;
    list-style: none;
  }
  .creator-contacts a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--paper);
    font-size: var(--fs-body);
    font-weight: 600;
    text-underline-offset: 3px;
    word-break: break-all;
  }
  .creator a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .creator-btn {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--ink);
    text-decoration: none;
  }
  .site-footer .copyright {
    margin-top: var(--s3);
    font-size: 0.8125rem;
  }
</style>
