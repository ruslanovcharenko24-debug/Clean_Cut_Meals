---
import ChoosePage from '../../../components/ChoosePage.astro';
import { pageProducts, type Product } from '../../../lib/products';

export function getStaticPaths() {
  return pageProducts.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<ChoosePage product={product} />
