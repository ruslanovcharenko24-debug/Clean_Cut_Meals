---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { orderLinks, demoServices, type Product, type ServiceStyle } from '../lib/products';

interface Props {
  product: Product;
  dishName: string;
  heading: string;
}
const { product, dishName, heading } = Astro.props;
const links = orderLinks(product);
const demos = demoServices(product);

// Official retailer logos (sources in data/order-links.json → services). Files are shown unchanged, aspect ratio kept.
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/retailers/*.{svg,png}', { eager: true });
function logoFor(s: ServiceStyle): ImageMetadata | null {
  return logoFiles[`../../${s.logo}`]?.default ?? null;
}
const isIcon = (s: ServiceStyle) => s.logo.endsWith('.png');
// Destinations for the accessible names; the visible limits live in "Where to buy" (InfoSections).
const NOTE: Record<string, string> = {
  supervalu: 'opens this meal',
  uber_eats: 'opens Centra Shandon Street',
};
const dialogId = `demo-${product.slug}`;
---

<section class="buy" id="buy" aria-labelledby="buy-title">
  <h2 id="buy-title" class="buy-title">{heading}</h2>
  <ul class="svc-row">
    {
      links.map((l) => {
        const logo = logoFor(l);
        return (
          <li>
            <a
              class={`svc svc--${l.service}`}
              href={l.url}
              rel="noopener noreferrer"
              target="_blank"
              style={`--svc-bg: ${l.bg}; --svc-fg: ${l.fg}`}
              aria-label={`${l.serviceName}: ${NOTE[l.service] ?? l.label} (opens in a new tab)`}
            >
              {logo ? <Image src={logo} alt="" height={64} class="svc-logo" /> : l.serviceName}
            </a>
          </li>
        );
      })
    }
    {
      demos.map((d) => {
        const logo = logoFor(d);
        return (
          <li>
            <button
              type="button"
              class={`svc svc--${d.service}`}
              data-demo-open={dialogId}
              style={`--svc-bg: ${d.bg}; --svc-fg: ${d.fg}`}
              aria-haspopup="dialog"
              aria-label={`${d.serviceName} (demo, opens an explanation)`}
            >
              {logo ? <Image src={logo} alt="" height={64} class:list={['svc-logo', { 'svc-logo--icon': isIcon(d) }]} /> : d.serviceName}
            </button>
          </li>
        );
      })
    }
  </ul>

  {
    demos.map((d) => (
      <dialog id={dialogId} class="demo" aria-labelledby={`${dialogId}-title`}>
        <h3 id={`${dialogId}-title`} class="demo-title">Choose a participating store — demo</h3>
        <p>
          This is a demo for the student showcase. We haven't confirmed which {d.serviceName} stores list {dishName}, so
          there's no store or meal link here.
        </p>
        <p class="demo-note">In a real version, you'd pick a nearby store that stocks this meal.</p>
        <form method="dialog">
          <button type="submit" class="btn btn--primary">Close</button>
        </form>
      </dialog>
    ))
  }
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-demo-open]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.demoOpen!) as HTMLDialogElement | null;
    if (!dialog) return;
    button.addEventListener('click', () => dialog.showModal());
    // Tap outside the box closes it too.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .buy {
    padding-top: var(--s3);
  }
  .buy-title {
    margin: 0 0 var(--s2);
    font-size: var(--fs-small);
    font-weight: 700;
  }
  /* Three services in one row at every phone width; each keeps its own colours. */
  .svc-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .svc-row li {
    display: flex;
  }
  .svc {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    min-height: 48px;
    padding: 6px var(--s2);
    border: 0;
    border-radius: 10px;
    background: var(--svc-bg);
    color: var(--svc-fg);
    font: inherit;
    cursor: pointer;
    text-decoration: none;
  }
  .svc:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .svc:active {
    transform: translateY(1px);
  }
  .svc :global(.svc-logo) {
    display: block;
    width: auto;
    max-width: 100%;
    height: 22px;
    object-fit: contain;
  }
  /* The Uber Eats file has green clear space built in (brand rule), so it is shown taller. */
  .svc--uber_eats :global(.svc-logo) {
    height: 34px;
  }
  .svc :global(.svc-logo--icon) {
    width: 36px;
    height: 36px;
    border-radius: 7px;
    clip-path: inset(1px round 7px);
  }
  .demo {
    max-width: min(26rem, calc(100vw - 2 * var(--gutter)));
    padding: var(--s4);
    border: 2px solid var(--ink);
    border-radius: 10px;
    color: var(--ink);
    background: var(--paper);
  }
  .demo::backdrop {
    background: rgb(36 1 76 / 0.45);
  }
  .demo-title {
    margin: 0 0 var(--s3);
    font-size: var(--fs-h3);
    line-height: 1.2;
  }
  .demo p {
    margin: 0 0 var(--s3);
  }
  .demo-note {
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .demo form {
    margin: 0;
  }
</style>
