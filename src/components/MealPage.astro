---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BuyMeal from './BuyMeal.astro';
import SendButton from './SendButton.astro';
import InfoSections from './InfoSections.astro';
import {
  absoluteUrl, band, shortName, officialName, packImage, perPack, perPackLabel, isCold, mealPath, invitePath, pickPath, cardPath,
  INVITE_TEXT, REPLY_TEXT, REPLY_AFTER, type MealMode, type Product,
} from '../lib/products';

// One meal page in three modes, all static so link previews read their own tags without JavaScript:
//   standard  /meals/<slug>/ and /s/<short>/   order for yourself + invite someone
//   invite    /invite/<short>/                  recipient picks: "This one for me" or another meal
//   pick      /pick/<short>/                    the meal someone picked, sent back to the inviter
interface Props {
  product: Product;
  /** Path this copy is served at; used for og:url. */
  path: string;
  mode?: MealMode;
}
const { product: p, path, mode = 'standard' } = Astro.props;
const img = packImage(p);
const name = shortName(p);
const protein = perPack(p, 'Protein');
const kcal = perPack(p, 'kcal');
const basis = perPackLabel(p);
const cold = isCold(p);

// Previews of personal messages (invite, pick) carry no project wording and do not repeat the message;
// the description is just the meal and its pack size. The disclaimer stays in the page's top strip and footer and on /about/.
const mealLine = `${name} · ${p.size}`;
const PREVIEW: Record<MealMode, { title: string; description: string }> = {
  standard: { title: 'View meal & order', description: 'Student concept — not an official Clean Cut Meals service.' },
  invite: { title: 'What would you fancy?', description: mealLine },
  pick: { title: 'This one looks lovely.', description: mealLine },
};
const chooseHref = mode === 'invite' ? `${invitePath(p)}choose/` : `${mealPath(p)}choose/`;
const BUY_HEADING: Record<MealMode, string> = {
  standard: 'Order to your door',
  invite: 'Or order to your door',
  pick: 'Order to your door',
};
---

<Base
  title={mode === 'standard' ? `${name} — Clean Cut Meals (student concept)` : `${name} — Clean Cut Meals`}
  description={p.description ?? officialName(p)}
  preview={{
    title: PREVIEW[mode].title,
    description: PREVIEW[mode].description,
    image: cardPath(p),
    imageAlt: `${name}: Clean Cut pack, ${protein ?? ''} protein, ${kcal ?? ''}, ${p.size}.`,
    url: path,
    // Invite and pick pages are their own canonical: pointing at /meals/ let link-preview bots show the
    // standard page's title and disclaimer instead of the invitation or reply.
    canonical: mode === 'standard' ? mealPath(p) : path,
  }}
>
  <article class:list={['dish', `dish--${mode}`]} style={`--band: ${band(p)}`}>
    {mode === 'invite' && <p class="mode-head">What would you fancy?</p>}
    {mode === 'pick' && <p class="mode-head">This one for me</p>}

    <section class="hero" aria-labelledby="dish-name">
      {img && (
      <div class="hero-photo">
        <Picture
          src={img}
          formats={['avif', 'webp']}
          widths={[400, 700, 1000, 1400]}
          sizes="(max-width: 520px) calc(100vw - 32px), 480px"
          alt={`${officialName(p)}, ${p.size} pack`}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      )}
      <div class:list={['hero-band wrap', { 'hero-band--solo': !img }]}>
        <h1 id="dish-name" class="dish-name">{name}</h1>
      </div>
    </section>

    <section class="facts wrap" aria-label="Key facts, per pack">
      <dl>
        <div><dt>Pack</dt><dd>{p.size}</dd></div>
        <div><dt>Protein</dt><dd>{protein ?? '—'}</dd></div>
        <div><dt>Energy</dt><dd>{kcal ?? '—'}</dd></div>
      </dl>
    </section>

    {
      mode === 'invite' ? (
        <div class="wrap primary">
          <SendButton
            id="reply"
            label="This one for me"
            sub="Opens your share menu. You choose who to send it to."
            text={REPLY_TEXT}
            after={REPLY_AFTER}
            url={absoluteUrl(pickPath(p), Astro.site)}
            path={pickPath(p)}
          />
          <a class="btn btn-secondary-wide" href={chooseHref}>Choose another meal</a>
          <BuyMeal product={p} dishName={name} heading={BUY_HEADING[mode]} />
        </div>
      ) : (
        <div class="wrap">
          <BuyMeal product={p} dishName={name} heading={BUY_HEADING[mode]} />
          {mode === 'standard' && (
            <div class="primary">
              <SendButton
                id="invite"
                label="Thinking of someone?"
                sub="Send them something they might like. Let them choose — pick it up for them, or they can order delivery."
                text={INVITE_TEXT}
                url={absoluteUrl(invitePath(p), Astro.site)}
                path={invitePath(p)}
              />
            </div>
          )}
        </div>
      )
    }

    <section class="wrap dish-about" aria-label="About this meal">
      {p.description && <p class="desc">{p.description}</p>}
      <ul class="about-facts">
        <li>Protein and energy {basis}, as printed on the product card.</li>
        {!cold && p.ready_claim && <li>{p.ready_claim}, according to the pack. Follow the heating instructions on your pack.</li>}
        {p.origin_statements.length > 0 && <li>Made with {p.origin_statements.join(', ')}.</li>}
      </ul>
    </section>

    <nav class="wrap secondary" aria-label="More options">
      <a class="btn btn--small" href={cold ? '#how-to-enjoy' : '#how-to-heat'} data-open-heat>{cold ? 'How to enjoy' : 'How to heat'}</a>
      {mode !== 'invite' && <a class="btn btn--small" href={chooseHref}>Choose another meal</a>}
    </nav>

    <section class="more" aria-label="More about this meal">
      <InfoSections product={p} />
    </section>
  </article>
</Base>

<script>
  // "How to heat" opens its section below instead of jumping to a closed one.
  document.querySelectorAll<HTMLAnchorElement>('[data-open-heat]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const section = document.getElementById(link.hash.slice(1)) as HTMLDetailsElement | null;
      if (!section) return;
      event.preventDefault();
      section.open = true;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      section.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      // Move focus only for keyboard activation (detail === 0); after a tap it would draw a focus ring
      // across the summary that reads as an extra divider.
      if ((event as MouseEvent).detail === 0) section.querySelector('summary')?.focus({ preventScroll: true });
    });
  });
</script>

<style>
  .mode-head {
    margin: 0;
    padding: var(--s2) var(--gutter) var(--s3);
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.1;
  }
  .primary {
    padding-top: var(--s4);
  }
  .dish--invite .primary {
    padding-top: var(--s3);
  }
  .btn-secondary-wide {
    margin-top: var(--s2);
    min-height: 52px;
  }
  .secondary {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s2);
    padding-top: var(--s4);
    padding-bottom: var(--s5);
  }
  .btn--small {
    min-height: 48px;
    padding: var(--s1) var(--s2);
    font-size: var(--fs-small);
    text-align: center;
    line-height: 1.15;
  }
  .hero-photo {
    background: var(--paper);
    padding: var(--s2) var(--gutter) var(--s3);
  }
  /* Trimmed copy of the SuperValu photo (white background cropped, pack whole): it fills the phone width
     at its own aspect ratio, so nothing is stretched or cut. */
  .hero-photo :global(img) {
    display: block;
    width: 100%;
    max-width: 480px;
    height: auto;
    margin: 0 auto;
  }
  /* Two-tone split from the pack backdrop (brandbook p.21, p.24): solid band colour under the image */
  .hero-band {
    background: var(--band);
    padding-top: 12px;
    padding-bottom: 12px;
  }
  /* Public build without pack photos: the colour band carries the first screen on its own */
  .hero-band--solo {
    padding-top: var(--s5);
    padding-bottom: var(--s5);
  }
  .hero-band > * {
    max-width: var(--measure);
  }
  .dish-name {
    margin: 0;
    font-size: clamp(1.875rem, 8.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .dish-about {
    padding-top: var(--s4);
  }
  .desc {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.45;
    max-width: var(--measure);
  }
  .about-facts {
    margin: var(--s2) 0 0;
    padding-left: 1.1em;
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .about-facts li + li {
    margin-top: var(--s1);
  }
  .facts {
    padding-top: 12px;
  }
  .facts dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
  }
  .facts dl > div {
    padding: var(--s2);
  }
  .facts dl > div + div {
    border-left: 1px solid var(--rule);
  }
  .facts dt {
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .facts dd {
    margin: var(--s1) 0 0;
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.1;
    white-space: nowrap;
  }
</style>
