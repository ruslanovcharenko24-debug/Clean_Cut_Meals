---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { orderLinks, type Product } from '../lib/products';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const links = orderLinks(product);

// Retailer logos are shown only from files placed in assets/retailers/<service>.(svg|png) after permission is confirmed
// (docs/OPEN_QUESTIONS.md Q12). assets/ is not published, so the public site always shows the name as text.
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/retailers/*.{svg,png}', { eager: true });
function logoFor(service: string): ImageMetadata | null {
  const hit = Object.entries(logoFiles).find(([path]) => path.split('/').pop()!.startsWith(`${service}.`));
  return hit?.[1].default ?? null;
}
---

<section class="buy" id="buy" aria-labelledby="buy-title">
  <h2 id="buy-title" class="buy-title">Buy this meal</h2>
  {
    links.length > 0 ? (
      <ul class="buy-list">
        {links.map((l) => {
          const logo = logoFor(l.service);
          return (
            <li>
              <a class="buy-btn" href={l.url} rel="noopener noreferrer" target="_blank">
                <span class="buy-service">
                  {logo ? <Image src={logo} alt={l.serviceName} height={24} class="buy-logo" /> : l.serviceName}
                </span>
                <span class="buy-action">{l.label}</span>
                <svg class="buy-ext" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                  <path d="M6 3H3v10h10v-3M9 2h5v5M14 2 7 9" fill="none" stroke="currentColor" stroke-width="1.8" />
                </svg>
                <span class="visually-hidden"> (opens {l.serviceName} in a new tab)</span>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p>Look for it in the chilled aisle at SuperValu and Centra.</p>
    )
  }
  <p class="buy-note">Availability and delivery depend on your location.</p>
</section>

<style>
  .buy {
    padding-top: var(--s3);
  }
  .buy-title {
    margin: 0 0 var(--s2);
    font-size: var(--fs-body);
    font-weight: 700;
  }
  /* Two services side by side on a phone; each button keeps full-size text and a tall target. */
  .buy-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--s2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .buy-list li {
    display: flex;
  }
  .buy-btn {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    width: 100%;
    min-height: 72px;
    padding: var(--s2) calc(var(--s3) + 18px) var(--s2) var(--s3);
    border: 2px solid var(--ink);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  .buy-btn:hover {
    background: var(--rule);
  }
  .buy-btn:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .buy-service {
    font-size: var(--fs-body);
    font-weight: 700;
    line-height: 1.2;
  }
  .buy-logo {
    display: block;
    width: auto;
    height: 24px;
  }
  .buy-action {
    font-size: var(--fs-small);
    line-height: 1.25;
  }
  .buy-ext {
    position: absolute;
    top: var(--s2);
    right: var(--s2);
  }
  .buy-note {
    margin: var(--s2) 0 0;
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
</style>
