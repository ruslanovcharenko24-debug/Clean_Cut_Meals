---
// One full-width send action. Opens the system share sheet with a short message and an absolute link;
// without it, copies the same message. The receiving app builds the preview from the link (Open Graph),
// so no title or image file is attached.
interface Props {
  id: string;
  label: string;
  /** Short line under the button */
  sub?: string;
  /** Message text before the link */
  text: string;
  /** Optional text after the link (e.g. an emoji); the whole message is then shared as one text so the order is kept */
  after?: string;
  /** Absolute public URL when configured */
  url: string | null;
  /** Site path (with base), used when url is null (local preview) */
  path: string;
}
const { id, label, sub, text, after, url, path } = Astro.props;
const shown = url ?? path;
const tail = after ? ` ${after}` : '';
---

<div class="send" data-send data-text={text} data-after={after} data-url={url ?? undefined} data-path={path}>
  <button type="button" class="btn btn--primary send-btn" aria-describedby={sub ? `${id}-sub` : undefined}>{label}</button>
  {sub && <p class="send-sub" id={`${id}-sub`}>{sub}</p>}
  <div class="send-panel" data-send-panel hidden>
    <label for={`${id}-msg`} class="send-label">Copy this message</label>
    <textarea id={`${id}-msg`} class="send-msg" rows="3" readonly data-send-msg>{`${text} ${shown}${tail}`}</textarea>
  </div>
  <p class="send-status" role="status" aria-live="polite" data-send-status></p>
  <noscript><p class="send-sub">Send this: {`${text} ${shown}${tail}`}</p></noscript>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-send]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('.send-btn')!;
    const panel = root.querySelector<HTMLElement>('[data-send-panel]')!;
    const box = root.querySelector<HTMLTextAreaElement>('[data-send-msg]')!;
    const status = root.querySelector<HTMLElement>('[data-send-status]')!;
    const text = root.dataset.text!;
    const url = root.dataset.url || new URL(root.dataset.path!, window.location.origin).href;
    const after = root.dataset.after;
    const message = after ? `${text} ${url} ${after}` : `${text} ${url}`;
    box.value = message;

    const say = (msg: string) => {
      status.textContent = '';
      // Set on the next frame so a repeated message is announced again.
      requestAnimationFrame(() => (status.textContent = msg));
    };
    const copy = async () => {
      try {
        if (!navigator.clipboard) throw new Error('no clipboard');
        await navigator.clipboard.writeText(message);
        say('Message copied. Paste it into your chat.');
      } catch {
        panel.hidden = false;
        box.focus();
        box.select();
        say('Copy the selected message.');
      }
    };

    button.addEventListener('click', async () => {
      // With text after the link, share one string: apps place a separate url field where they like.
      const data: ShareData = after ? { text: message } : { text, url };
      if (typeof navigator.share === 'function' && (!navigator.canShare || navigator.canShare(data))) {
        try {
          await navigator.share(data);
        } catch (err) {
          // Closing the share sheet is a normal choice, not an error.
          if ((err as DOMException).name !== 'AbortError') await copy();
        }
        return;
      }
      await copy();
    });
  });
</script>

<style>
  .send-btn {
    min-height: 60px;
    font-size: var(--fs-h3);
    font-weight: 700;
  }
  .send-sub {
    margin: var(--s2) 0 0;
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
  .send-panel {
    margin-top: var(--s3);
  }
  .send-label {
    display: block;
    margin-bottom: var(--s2);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .send-msg {
    width: 100%;
    padding: var(--s2) var(--s3);
    border: 2px solid var(--ink);
    border-radius: 0;
    font: 400 var(--fs-small) / 1.35 var(--font);
    color: var(--ink);
    background: var(--surface);
    resize: none;
  }
  .send-status {
    margin: var(--s2) 0 0;
    font-weight: 600;
  }
  .send-status:empty {
    display: none;
  }
</style>
